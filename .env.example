NEXO_ADDR=:8090
NEXO_DATA_DIR=./data
NEXO_WEB_DIR=./web
NEXO_ACCESS_TOKEN=replace-with-a-long-random-secret
NEXO_PAYMENT_URL=
NEXO_PRO_KEY=replace-with-a-long-random-license-key

# Optional automatic transcription (FFmpeg required)
NEXO_TRANSCRIPTION_KEY=
NEXO_TRANSCRIPTION_MODEL=whisper-1
NEXO_TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions

# Optional evidence-grounded answers (OpenAI-compatible Chat Completions)
NEXO_LLM_API_KEY=
NEXO_LLM_MODEL=gpt-4o-mini
NEXO_LLM_URL=https://api.openai.com/v1/chat/completions

# Optional PrismaTec-Core AIP v1
NEXO_PRISMATEC_URL=http://127.0.0.1:8080
NEXO_PRISMATEC_TOKEN=

# Optional Alset MiniNode (Mind / Zyrion / LispAI)
NEXO_MININODE_URL=http://127.0.0.1:5177
